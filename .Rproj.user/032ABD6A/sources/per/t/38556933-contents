##########
########## Test de Student pour 2 échantillons indépendants
##########

# Question : existe-t-il une difference de taille des poissons entre les deux groupes dasn Datafish ?
# On peut representer graphiquement les donnees avec un boxplot
boxplot(Datafish$Mesure ~ Datafish$Groupe,
        xlab = "Régime alimentaire",
        ylab = "Taille des poissons (cm)")


###################################################
# FACULTATIF : le meme graphique avec ggplot2
library(ggplot2)
ggplot(Datafish, aes(x = Groupe, y = Mesure)) +
  geom_boxplot() +
  labs(
    x = "Régime alimentaire",
    y = "Taille des poissons (cm)"
  )
###################################################

# Choix du test : test t pour deux echantillons independants
# Les effectifs sont legerement > 30 ; on verifie les conditions d'application
# Nous avons deja verifie precedemment que les echantillons sont issus de distributions normales
tapply(Datafish$Mesure, Datafish$Groupe, shapiro.test)

# Test d'egalite des variances
bartlett.test(Datafish$Mesure ~ Datafish$Groupe)
# Non rejet de H0, pas de difference significative entre les variances

# Les conditions d'application du test sont vérifiées. 
# Test de comparaison des deux groupes indépendants sous R :
t.test(Datafish$Mesure~Datafish$Groupe,var.equal=T) # test de Student qui part du principe que les variances sont egales

# Lorsqu'au moins un des echantillons est de petite taille,
# et si les variances sont differentes,
# ajouter l'argument var.equal = F : on conduit alors un test t de Welch.

# Lorsqu'au moins un des echantillons est de petite taille, 
# et si les donnees ne sont ni gaussiennes, ni transformables,
# alors on peut conduire un test par re-echantillonnage -disponible dans les packages lmperm, resample, boot ...

# On peut aussi faire un test non parametrique, le test de Mann-Whitney, c'est plus frequent (mais moins puissant).
wilcox.test(Datafish$Mesure~Datafish$Groupe)
# Le warning indique juste que la p-value est calculee sans ajustement avec les valeurs ex-aequo ;
# ce n'est pas un message d'erreur !


##########
########## Test de Student pour 2 echantillons apparies
##########

# On recupere le fichier Sommeil.csv, qui contient les mesures de la duree du sommeil d'etudiants avant et après un examen
Sommeil=read.csv("Sommeil.csv", sep=";", dec=",")
#On cherche a savoir si les etudiants dorment moins avant leur examen par rapport à après l'examen

# Choix du test : t.test pour 2 ech apparies
dim(Sommeil) #les echantillons sont d'effectif < 30
# On verifie la normalite de la difference (effectif n < 30) et non pas des mesures
delta=Sommeil$Sommeil.Avant - Sommeil$Sommeil.Apres
shapiro.test(delta)

# Puis on fait le test t
t.test(Sommeil$Sommeil.Avant,Sommeil$Sommeil.Apres, paired=T, alternative="less")
# On ne verifie pas l'egalite des variances car c'est un test a 1 echantillon "deguise".
t.test(delta, mu=0, alternative = "less")

# La encore, en cas de petits echantillons non gaussiens, on peut aussi faire un test non parametrique.
# C'est le test de Wilcoxon, frequemment employe dans ce cas mais moins puissant qu'un test par re-echantillonnage.
wilcox.test(Sommeil$Sommeil.Avant,Sommeil$Sommeil.Apres,paired=T, alternative = "less")
# Concernant le warning : voir plus haut !


